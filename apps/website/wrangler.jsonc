{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "removent-site",
  "account_id": "b6754402d59fc29ee8b62119014fec89",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "removent.pwp.sh", "custom_domain": true }
  ]
}
