# Rust build artifacts
/target/

# Swift build artifacts
/apps/tray/.build/
/packages/apple-cloud-sync/.build/
/apps/cloud-sync-helper/.build/
/apps/cloud-sync-helper/DerivedData*/

# Packaged app bundles, DMG/zip artifacts, generated update manifests
/dist/

# Local runtime data: device identity keys, settings, logs, sockets.
# Never commit this — it contains private key material.
/userdata/

# macOS noise
.DS_Store

# Local release tooling
/.venv-release/
__pycache__/
node_modules/
.wrangler/
.dev.vars*
!*.example

# Generated iOS project and Rust artifacts
/apps/mobile/Libraries/
/apps/mobile/DerivedData*/

# Native generated projects and web output
/apps/mobile/*.xcodeproj/
/apps/cloud-sync-helper/*.xcodeproj/
/apps/website/.svelte-kit/
/apps/website/build/
/apps/website/test-results/
